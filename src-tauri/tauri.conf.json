{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TNS Energy Studio",
  "version": "0.2.1",
  "identifier": "com.nazu228.tnsstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../apps/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ТНС Энерго — Студия расчёта начислений",
        "width": 1280,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/nazu228/tns-studio/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NkQ2OUU3NDdBOTkxRDMKUldUVGthbEg1Mmx0S1VLbFd0bzdZRUJaQUl3ZUdyZkJ4TXpFK2NpV2g1NUliSVBDVkllOFJ1UWIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["../crates/tns-pdf/vendor/pdfium.dll"],
    "createUpdaterArtifacts": true
  }
}
